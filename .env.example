# Workbox local configuration template.
# Copy to `.env` (git-ignored) and adjust. Never commit real credentials.
# Every setting is defined exactly once; the app, the tests and Docker Compose all read these.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
# Where Workbox connects. To use the bundled container, keep COMPOSE_PROFILES=postgres and
# these defaults. To use a PostgreSQL you already run, set COMPOSE_PROFILES= (empty) and point
# these at your server.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=workbox
DB_PASSWORD=change-me-local-dev
DB_NAME=workbox
# Integration tests connect here (and create/drop throwaway databases), never to DB_NAME.
DB_TEST_NAME=workbox_test

# --- Redis -------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=

# --- Docker Compose ----------------------------------------------------------
# `postgres` = also start the bundled PostgreSQL container. Empty = Redis only.
COMPOSE_PROFILES=postgres

# --- Credential vault (see docs/adr/003-credential-vault-and-master-key.md) ----
# 32-byte base64 master key that encrypts stored tokens. Left empty on purpose: generate yours with
#   pnpm vault:generate-key
# (writes it into .env without printing it). Back it up separately from database backups.
WORKBOX_MASTER_KEY=
WORKBOX_MASTER_KEY_VERSION=1
# Only while rotating keys: comma-separated "<version>:<base64>" of previous keys.
WORKBOX_PREVIOUS_MASTER_KEYS=

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Comma-separated browser origins allowed by CORS. Empty disables CORS.
CORS_ORIGINS=

# --- Worker ------------------------------------------------------------------
# Defaults to <hostname>:<pid> when unset.
WORKER_ID=
# Claude Code executable used by the worker (name on PATH or absolute path).
CLAUDE_CODE_COMMAND=
# Author name for commits Workbox makes; the email is the account's no-reply address.
WORKBOX_GIT_AUTHOR_NAME=
# Agent time limit per run, in minutes.
WORKBOX_RUN_TIMEOUT_MINUTES=30
# Where the worker keeps cloned repositories. Default: workspaces/ in this project folder
# (git-ignored). Relative paths resolve against this folder. Any other folder inside this
# repository must be git-ignored, or the worker refuses to start.
WORKBOX_WORKSPACES_DIR=
# Saved run files: agent transcript, full check output, patch. Default: <workbox>/artifacts
# (git-ignored). Deleted after WORKBOX_ARTIFACT_RETENTION_DAYS (default 7).
WORKBOX_ARTIFACTS_DIR=
WORKBOX_ARTIFACT_RETENTION_DAYS=7
WORKER_CONCURRENCY=1
